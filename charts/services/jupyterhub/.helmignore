# Upstream documentation of the vendored charts: not needed to render, and the
# whole chart is stored in every Helm release Secret.
vendor/*/README.md
vendor/*/README.md.gotmpl
vendor/*/CHANGELOG.md
vendor/*/docs/
vendor/*/test/
vendor/*/release-please-config.json
vendor/*/.release-please-manifest.json
vendor/*/.github/
.git/
vendor/*/ci/
# Plain text named like a partial: Helm discards the top-level text of
# partials, okdp.vendor.render prints it.
vendor/jupyterhub/templates/proxy/autohttps/_README.txt
