{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "airflow",
  "type": "object",
  "properties": {
    "global": {
      "type": "object",
      "description": "Platform values, from platform/platform-values.yaml (global.okdp)."
    },
    "connections": {
      "type": "object",
      "description": "External connections, one values layer per projects/<project>/connections/<name>.yaml.",
      "additionalProperties": {
        "type": "object",
        "required": [
          "contract"
        ],
        "properties": {
          "contract": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "secretRef": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "okdp-lib": {
      "type": "object",
      "description": "Values slot Helm creates for the okdp-lib library dependency. Not a parameter."
    },
    "db": {
      "type": "string",
      "title": "Metadata database",
      "description": "Connection to the SQL database server hosting the Airflow metadata database.",
      "x-okdp-connection-ref": {
        "contract": "database-server"
      },
      "x-ui-group": "Cluster",
      "x-ui-order": 2
    },
    "metadataSecret": {
      "type": "string",
      "title": "Metadata connection secret",
      "description": "Secret with key connection holding the full SQLAlchemy connection string.",
      "x-ui-group": "Cluster",
      "x-ui-order": 3
    },
    "schedulerMemoryGi": {
      "type": "number",
      "title": "Scheduler memory (GiB)",
      "default": 1,
      "multipleOf": 0.25,
      "x-ui-group": "Sizing",
      "x-ui-order": 1,
      "x-ui-columns": 2,
      "x-ui-advanced": true
    },
    "webserverMemoryGi": {
      "type": "number",
      "title": "Webserver memory (GiB)",
      "default": 1,
      "multipleOf": 0.25,
      "x-ui-group": "Sizing",
      "x-ui-order": 2,
      "x-ui-columns": 2,
      "x-ui-advanced": true
    },
    "dagProcessorMemoryGi": {
      "type": "number",
      "title": "DAG processor memory (GiB)",
      "default": 1,
      "multipleOf": 0.25,
      "x-ui-group": "Sizing",
      "x-ui-order": 3,
      "x-ui-columns": 2,
      "x-ui-advanced": true
    },
    "dagProcessorCpuCores": {
      "type": "number",
      "title": "DAG processor CPU (cores)",
      "default": 0.75,
      "multipleOf": 0.05,
      "x-ui-group": "Sizing",
      "x-ui-order": 4,
      "x-ui-columns": 2,
      "x-ui-advanced": true
    },
    "oidcRoleMapping": {
      "type": "object",
      "title": "Role mapping",
      "description": "Map of OIDC groups to lists of Airflow roles.",
      "default": {},
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "x-ui-group": "Authentication",
      "x-ui-order": 4,
      "x-ui-advanced": true
    },
    "storage": {
      "type": "string",
      "title": "Object store",
      "description": "Connection to the S3-compatible object store the DAGs read and write.",
      "x-okdp-connection-ref": {
        "contract": "s3"
      },
      "x-ui-group": "Storage",
      "x-ui-order": 5
    },
    "s3SecretRef": {
      "type": "string",
      "title": "S3 credentials secret",
      "description": "Secret with keys accessKey and secretKey granting the DAGs access to the object store.",
      "x-ui-group": "Storage",
      "x-ui-order": 6
    },
    "dagsGitSync": {
      "type": "object",
      "title": "Git sync",
      "description": "Chart dags.gitSync values. Unquoted true/false is a boolean, an unquoted number is an int/float, quote to force a string. credentialsSecret.name carries the git credentials Secret name.",
      "default": {},
      "additionalProperties": true,
      "x-ui-group": "DAGs",
      "x-ui-widget": "key-value-scalar",
      "x-ui-order": 1
    }
  },
  "required": [
    "db",
    "metadataSecret",
    "storage",
    "s3SecretRef"
  ],
  "additionalProperties": false
}
